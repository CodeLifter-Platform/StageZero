@page "/setup"
@using Lifted.BlazorAuth.Basic.Models
@using Lifted.BlazorAuth.Basic.DataAdapters
@using Lifted.BlazorAuth.Basic.Services
@using Microsoft.Extensions.DependencyInjection
@inject IUserReader UserReader
@inject IUserWriter UserWriter
@inject IServiceProvider Services
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Setup</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">
    <MudPaper Elevation="4" Class="pa-8">
        <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Size="Size.Large" Class="mr-2" />
            Welcome
        </MudText>

        <MudText Typo="Typo.body1" Align="Align.Center" Class="mb-6" Color="Color.Secondary">
            Create your admin account
        </MudText>

        @if (_setupComplete)
        {
            <MudAlert Severity="Severity.Success" Class="mb-4">
                Admin account created. Redirecting to login...
            </MudAlert>
        }
        else if (_setupNotNeeded)
        {
            <MudAlert Severity="Severity.Info" Class="mb-4">
                Setup already completed. Redirecting to login...
            </MudAlert>
        }
        else
        {
            <MudTextField @bind-Value="_email"
                          Label="Admin Email"
                          Variant="Variant.Outlined"
                          InputType="InputType.Email"
                          Required="true"
                          Immediate="true"
                          HelperText="This is your login"
                          Class="mb-4"
                          Disabled="@_isLoading" />

            <MudTextField @bind-Value="_password"
                          Label="Password"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          Required="true"
                          Immediate="true"
                          HelperText="Minimum 8 characters"
                          Class="mb-4"
                          Disabled="@_isLoading" />

            <MudTextField @bind-Value="_confirmPassword"
                          Label="Confirm Password"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          Required="true"
                          Immediate="true"
                          Class="@(_optIn is { Choices.Count: > 0 } ? "mb-4" : "mb-6")"
                          Disabled="@_isLoading" />

            @if (_optIn is { Choices.Count: > 0 })
            {
                @* Optional, unchecked by default: the host app decides what is offered *@
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-1">
                    Optional
                </MudText>
                @foreach (var choice in _optIn.Choices)
                {
                    var key = choice.Key;
                    <MudCheckBox T="bool"
                                 Value="@_selectedOptIns.Contains(key)"
                                 ValueChanged="@(on => ToggleOptIn(key, on))"
                                 Color="Color.Primary"
                                 Dense="true"
                                 Disabled="@_isLoading"
                                 Label="@choice.Label" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block ml-8 mb-2">
                        @choice.Description
                    </MudText>
                }
                <div class="mb-4"></div>
            }

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">
                    @_errorMessage
                </MudAlert>
            }

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       OnClick="CreateAdminAccount"
                       Disabled="@(!CanSubmit || _isLoading)">
                @if (_isLoading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Creating Account...</span>
                }
                else
                {
                    <span>Create Admin Account</span>
                }
            </MudButton>
        }
    </MudPaper>
</MudContainer>

@code {
    private bool _isLoading;
    private bool _setupComplete;
    private bool _setupNotNeeded;
    private string? _errorMessage;

    private string _email = string.Empty;
    private string _password = string.Empty;
    private string _confirmPassword = string.Empty;

    // Opt-ins are an optional extension point; a host app that registers nothing
    // gets a form with no boxes.
    private ISignupOptIn? _optIn;
    private readonly HashSet<string> _selectedOptIns = new(StringComparer.Ordinal);

    private bool CanSubmit =>
        !string.IsNullOrWhiteSpace(_email)
        && !string.IsNullOrWhiteSpace(_password)
        && !string.IsNullOrWhiteSpace(_confirmPassword);

    protected override async Task OnInitializedAsync()
    {
        _optIn = Services.GetService<ISignupOptIn>();

        // Setup is a one-time page: with any user present it only redirects.
        var users = await UserReader.GetAllAsync();
        if (users.Any())
        {
            _setupNotNeeded = true;
            await Task.Delay(1500);
            Navigation.NavigateTo("/login");
        }
    }

    private void ToggleOptIn(string key, bool on)
    {
        if (on) _selectedOptIns.Add(key);
        else _selectedOptIns.Remove(key);
    }

    private async Task CreateAdminAccount()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var email = _email.Trim();
            if (string.IsNullOrWhiteSpace(email) || !email.Contains('@'))
            {
                _errorMessage = "Please enter a valid email address";
                return;
            }

            if (_password.Length < 8)
            {
                _errorMessage = "Password must be at least 8 characters long";
                return;
            }

            if (_password != _confirmPassword)
            {
                _errorMessage = "Passwords do not match";
                return;
            }

            // Double-check no users exist
            var existingUsers = await UserReader.GetAllAsync();
            if (existingUsers.Any())
            {
                Snackbar.Add("Setup has already been completed", Severity.Warning);
                Navigation.NavigateTo("/login");
                return;
            }

            // The first admin is whoever reaches a fresh install first. Their
            // address is the login, not a proof of anything, so it is marked
            // verified rather than gated on an email round-trip.
            var adminUser = new User
            {
                Email = email,
                PasswordHash = BCrypt.Net.BCrypt.HashPassword(_password),
                IsActive = true,
                RequiresPasswordChange = false,
                EmailVerified = true,
                CreatedAt = DateTime.UtcNow
            };

            await UserWriter.InsertAsync(adminUser);

            _setupComplete = true;
            Snackbar.Add("Admin account created successfully!", Severity.Success);

            await SubmitOptInsAsync(email);

            await Task.Delay(1500);
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error creating admin account: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    /// <summary>
    /// Best-effort, after the account exists: the signup is a courtesy, and its
    /// outcome is reported but can never fail setup.
    /// </summary>
    private async Task SubmitOptInsAsync(string email)
    {
        if (_optIn is null || _selectedOptIns.Count == 0) return;

        try
        {
            var result = await _optIn.SubmitAsync(email, _selectedOptIns.ToArray());
            Snackbar.Add(result.Message, result.Sent ? Severity.Info : Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Couldn't send the signup: {ex.Message}", Severity.Warning);
        }
    }
}
