@page "/tunnel-routes"
@implements IDisposable
@using StageZero.Application.Areas.DnsConfig
@using StageZero.Models
@using StageZero.Services.Access
@inject ITunnelManagementViewModel VM
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Tunnel Routes - StageZero</PageTitle>

<RequireAuth>
@if (VM.IsLoading)
{
    <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-16">
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
        <MudText Typo="Typo.body1" Class="mt-4 text-center">Loading...</MudText>
    </MudContainer>
}
else
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
        <MudText Typo="Typo.h4" Class="mb-2">Tunnel Routes</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-6">
            Each route publishes a hostname through your Cloudflare Tunnel and forwards it
            to a service on this network. Cloudflare handles TLS &mdash; no ports to open.
        </MudText>

        @if (!VM.IsTunnelConfigured)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4">
                <MudText Typo="Typo.body1" Class="mb-2">
                    Cloudflare Tunnel isn't set up yet. Routes saved here can't reach Cloudflare
                    until setup is complete.
                </MudText>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Warning"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Settings"
                           Href="/tunnel-settings">
                    Go to Tunnel Setup
                </MudButton>
            </MudAlert>
        }
        else
        {
            <MudAlert Severity="Severity.Success" Icon="@Icons.Material.Filled.Hub" Class="mb-4" Dense="true">
                Connected to tunnel <strong>@VM.TunnelName</strong>
                @if (!string.IsNullOrEmpty(VM.ZoneName))
                {
                    <text> on zone <strong>@VM.ZoneName</strong></text>
                }
            </MudAlert>
        }

        @* Action Buttons *@
        <div class="d-flex gap-2 mb-4">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@NavigateToAdd">
                Add Route
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.Settings"
                       Href="/tunnel-settings">
                Tunnel Setup
            </MudButton>
        </div>

        @* Routes List *@
        @if (VM.Routes.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Class="mt-4">
                No tunnel routes configured yet. Click "Add Route" to publish your first hostname.
            </MudAlert>
        }
        else
        {
            <MudCard Elevation="2">
                <MudCardContent>
                    <MudTable Items="@VM.Routes" Hover="true" Dense="true" Striped="true">
                        <HeaderContent>
                            <MudTh>Hostname</MudTh>
                            <MudTh>Forwards To</MudTh>
                            <MudTh>Access</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh>Actions</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Hostname">
                                <MudText Typo="Typo.body1" Style="font-weight: 600;">@context.DomainName</MudText>
                                @if (!string.IsNullOrEmpty(context.Notes))
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Notes</MudText>
                                }
                            </MudTd>
                            <MudTd DataLabel="Forwards To">
                                <MudText Typo="Typo.body2" Class="sz-mono">@context.ForwardUrl</MudText>
                            </MudTd>
                            <MudTd DataLabel="Access">
                                @if (context.Access.Mode == AccessMode.None)
                                {
                                    <MudTooltip Text="No Access policy — anyone can reach this hostname">
                                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Filled.LockOpen">
                                            Public
                                        </MudChip>
                                    </MudTooltip>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.Lock">
                                        @context.Access.Mode.ToDisplayName()
                                    </MudChip>
                                }
                            </MudTd>
                            <MudTd DataLabel="Status">
                                @if (context.IsEnabled)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success">Active</MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">Disabled</MudChip>
                                }
                            </MudTd>
                            <MudTd DataLabel="Actions">
                                <MudTooltip Text="Access status">
                                    <MudIconButton Icon="@Icons.Material.Filled.Shield"
                                                   Size="Size.Small"
                                                   Color="Color.Info"
                                                   OnClick="@(() => NavigateToAccessStatus(context.Id))" />
                                </MudTooltip>
                                <MudTooltip Text="Edit">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Size="Size.Small"
                                                   Color="Color.Primary"
                                                   OnClick="@(() => NavigateToEdit(context.Id))" />
                                </MudTooltip>
                                <MudTooltip Text="@(context.IsEnabled ? "Disable" : "Enable")">
                                    <MudIconButton Icon="@Icons.Material.Filled.Power"
                                                   Size="Size.Small"
                                                   Color="Color.Secondary"
                                                   OnClick="@(() => ToggleRoute(context.Id))" />
                                </MudTooltip>
                                <MudTooltip Text="Delete">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="@(() => DeleteRoute(context.Id))" />
                                </MudTooltip>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudCardContent>
            </MudCard>
        }
    </MudContainer>
}
</RequireAuth>

@code {
    protected override async Task OnInitializedAsync()
    {
        VM.PropertyChanged += OnVmPropertyChanged;
        await VM.OnInitializedAsync();
    }

    private void OnVmPropertyChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    private void NavigateToAdd() => Navigation.NavigateTo("/tunnel-routes/add");

    private void NavigateToEdit(int id) => Navigation.NavigateTo($"/tunnel-routes/edit/{id}");

    private void NavigateToAccessStatus(int id) => Navigation.NavigateTo($"/tunnel-routes/access/{id}");

    private async Task ToggleRoute(int id)
    {
        try
        {
            var result = await VM.ToggleRouteAsync(id);
            Snackbar.Add("Route status updated", Severity.Success);

            // Re-enabling a route can mint a service token that was still pending. Its
            // secret exists only in this result, so it has to be shown now.
            if (result?.Access?.NewServiceToken is not null)
            {
                await ShowServiceTokenAsync(result.Access.NewServiceToken, result.Access.Hostname);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ShowServiceTokenAsync(MintedServiceToken token, string hostname)
    {
        var parameters = new DialogParameters
        {
            ["Token"] = token,
            ["Hostname"] = hostname
        };

        // Not dismissable: closing it by accident would destroy the only copy of the secret.
        var options = new DialogOptions
        {
            CloseButton = false,
            BackdropClick = false,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<ServiceTokenSecretDialog>(
            "Service token created", parameters, options);

        await dialog.Result;
    }

    private async Task DeleteRoute(int id)
    {
        var route = VM.Routes.FirstOrDefault(r => r.Id == id);
        if (route == null) return;

        var parameters = new DialogParameters
        {
            ["ContentText"] = $"Delete the route for '{route.DomainName}'? This removes the tunnel ingress rule, the DNS record, and its Cloudflare Access application and policies.",
            ["ButtonText"] = "Delete",
            ["Color"] = Color.Error
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<ConfirmationDialog>("Delete Tunnel Route", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            try
            {
                var teardown = await VM.DeleteRouteAsync(id);
                Snackbar.Add("Route deleted", Severity.Success);

                // Say what was left behind rather than letting a retained token go unnoticed.
                if (teardown?.ServiceTokenRetainedReason is not null)
                {
                    Snackbar.Add(teardown.ServiceTokenRetainedReason, Severity.Info);
                }

                foreach (var warning in teardown?.Warnings ?? new List<string>())
                {
                    Snackbar.Add(warning, Severity.Warning);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

    public void Dispose()
    {
        VM.PropertyChanged -= OnVmPropertyChanged;
    }
}
