@using MudBlazor
@using StageZero.Services.Access

@* Shows a freshly minted Access service token. Cloudflare returns the client secret only
   at creation, so this dialog is the one and only chance to copy it. Nothing here is
   persisted or logged. *@

<MudDialog>
    <DialogContent>
        <MudAlert Severity="Severity.Warning" Icon="@Icons.Material.Filled.Warning" Class="mb-4">
            <MudText Typo="Typo.body1" Style="font-weight: 600;">
                This will not be shown again.
            </MudText>
            <MudText Typo="Typo.body2">
                Cloudflare returns the client secret only when the token is created. StageZero
                does not store it. Copy it somewhere safe before closing this dialog &mdash; if
                you lose it you will have to rotate the token and update every client.
            </MudText>
        </MudAlert>

        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            Service token <strong>@Token.Name</strong> now guards
            <strong>@Hostname</strong>. Clients send these two values as the
            <code>CF-Access-Client-Id</code> and <code>CF-Access-Client-Secret</code> headers.
        </MudText>

        <MudTextField Value="@Token.ClientId"
                      T="string"
                      Label="CF-Access-Client-Id"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      ReadOnly="true"
                      Class="mb-4 sz-mono"
                      Adornment="Adornment.End"
                      AdornmentIcon="@Icons.Material.Filled.ContentCopy"
                      OnAdornmentClick="@(() => CopyAsync(Token.ClientId))" />

        <MudTextField Value="@Token.ClientSecret"
                      T="string"
                      Label="CF-Access-Client-Secret"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      ReadOnly="true"
                      InputType="@(_secretVisible ? InputType.Text : InputType.Password)"
                      Class="mb-2 sz-mono"
                      Adornment="Adornment.End"
                      AdornmentIcon="@(_secretVisible ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                      OnAdornmentClick="@ToggleSecret" />

        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.ContentCopy"
                   OnClick="@(() => CopyAsync(Token.ClientSecret))">
            Copy secret
        </MudButton>

        @if (Token.ExpiresAt.HasValue)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-4 d-block">
                Expires @Token.ExpiresAt.Value.ToString("u").
            </MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudCheckBox @bind-Value="_acknowledged"
                     T="bool"
                     Color="Color.Primary"
                     Label="I have saved the client secret" />
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="@(!_acknowledged)"
                   OnClick="Close">
            Done
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    MudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public MintedServiceToken Token { get; set; } = new();

    [Parameter]
    public string Hostname { get; set; } = string.Empty;

    [Inject]
    private IJSRuntime JS { get; set; } = null!;

    [Inject]
    private ISnackbar Snackbar { get; set; } = null!;

    private bool _secretVisible;
    private bool _acknowledged;

    private void ToggleSecret() => _secretVisible = !_secretVisible;

    private async Task CopyAsync(string value)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", value);
            Snackbar.Add("Copied to clipboard", Severity.Success);
        }
        catch (Exception)
        {
            // Clipboard access needs a secure context and user permission. Falling back to
            // "select it yourself" is better than losing the only copy of the secret.
            Snackbar.Add("Could not copy automatically — select the value and copy it manually.",
                Severity.Warning);
        }
    }

    private void Close() => MudDialog.Close(DialogResult.Ok(true));
}
