@inherits LayoutComponentBase
@implements IDisposable
@inject IAppVM VM
@inject NavigationManager Navigation
@using Lifted.BlazorAuth.Basic.Services
@inject IAuthService AuthService
@using StageZero.Application.Theme

<MudThemeProvider Theme="@StageZeroTheme.Theme" @bind-IsDarkMode="@VM.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    @* ═══════════════════════════════════════════════════════════════ *@
    @* HEADER - Dense *@
    @* ═══════════════════════════════════════════════════════════════ *@
    <MudAppBar Elevation="1" Dense="true">
        <MudText Typo="Typo.h6" Class="ml-3">StageZero</MudText>
        <MudSpacer />

        @* Current IP - signed-in users only (see CurrentIpChip) *@
        @if (VM.IsAuthenticated)
        {
            <CurrentIpChip />
        }

        <MudSpacer />
        <MudTooltip Text="@(VM.IsDarkMode ? "Light Mode" : "Dark Mode")">
            <MudIconButton Icon="@(VM.IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Inherit"
                           OnClick="@VM.ToggleDarkModeAsync" />
        </MudTooltip>
        @if (VM.IsAuthenticated)
        {
            <MudMenu Icon="@Icons.Material.Filled.AccountCircle"
                     Color="Color.Inherit"
                     AnchorOrigin="Origin.BottomRight"
                     TransformOrigin="Origin.TopRight"
                     Dense="true">
                <ChildContent>
                    <MudMenuItem Disabled="true">
                        <MudText Typo="Typo.body2" Style="font-weight: 600;">@VM.CurrentUser?.Email</MudText>
                    </MudMenuItem>
                    <MudDivider />
                    <MudMenuItem Icon="@Icons.Material.Filled.Logout"
                                 OnClick="@HandleLogout">
                        Logout
                    </MudMenuItem>
                </ChildContent>
            </MudMenu>
        }
    </MudAppBar>

    @* The navigation is for signed-in users only; the sign-in pages get a bare app bar. *@
    @if (VM.IsAuthenticated)
    {
        @* ═══════════════════════════════════════════════════════════════ *@
        @* NAVIGATION DRAWER - Persistent, Mini, Non-Responsive *@
        @* ═══════════════════════════════════════════════════════════════ *@
        <MudDrawer @bind-Open="_drawerOpen"
                   Elevation="1"
                   ClipMode="DrawerClipMode.Always"
                   Variant="@DrawerVariant.Mini"
                   Breakpoint="Breakpoint.None"
                   Anchor="Anchor.Start"
                   Fixed="true"
                   OpenMiniOnHover="false">
            <MudNavMenu>
                <MudTooltip Text="Home" Placement="Placement.Right">
                    <MudNavLink Href="/" Icon="@Icons.Material.Filled.Home"></MudNavLink>
                </MudTooltip>
                <MudTooltip Text="IP Monitor" Placement="Placement.Right">
                    <MudNavLink Href="/ip-monitor" Icon="@Icons.Material.Filled.NetworkCheck"></MudNavLink>
                </MudTooltip>
                <MudTooltip Text="DNS Configuration" Placement="Placement.Right">
                    <MudNavLink Href="/dns-config" Icon="@Icons.Material.Filled.Dns"></MudNavLink>
                </MudTooltip>
                <MudTooltip Text="Tunnel Routes" Placement="Placement.Right">
                    <MudNavLink Href="/tunnel-routes" Icon="@Icons.Material.Filled.Hub"></MudNavLink>
                </MudTooltip>
                <MudTooltip Text="Tunnel Setup" Placement="Placement.Right">
                    <MudNavLink Href="/tunnel-settings" Icon="@Icons.Material.Filled.Settings"></MudNavLink>
                </MudTooltip>
            </MudNavMenu>
        </MudDrawer>
    }

    @* ═══════════════════════════════════════════════════════════════ *@
    @* MAIN CONTENT - 80% width, scrollable *@
    @* ═══════════════════════════════════════════════════════════════ *@
    <MudMainContent Style="max-width: 80%; margin: auto; overflow-y: auto;">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = false; // false = mini mode, true = expanded mode

    protected override async Task OnInitializedAsync()
    {
        await VM.OnInitializedAsync();

        // Subscribe to property changes to trigger UI updates
        if (VM is System.ComponentModel.INotifyPropertyChanged notifier)
        {
            notifier.PropertyChanged += (_, _) => InvokeAsync(StateHasChanged);
        }

        // Subscribe to navigation changes to refresh user state
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await VM.LoadThemePreferenceAsync();
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // Refresh current user when navigating (in case user logged in/out)
        await VM.RefreshCurrentUserAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login");
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
