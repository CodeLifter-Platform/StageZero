{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/StageZero/StageZero.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "web: install",
      "type": "shell",
      "command": "npm install --no-audit --no-fund",
      "options": { "cwd": "${workspaceFolder}/web" },
      "problemMatcher": []
    },
    {
      "label": "web: build",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/web" },
      "problemMatcher": []
    },
    {
      "label": "web: test",
      "type": "shell",
      "command": "npm test",
      "options": { "cwd": "${workspaceFolder}/web" },
      "problemMatcher": []
    },
    {
      "label": "build + web",
      "dependsOrder": "sequence",
      "dependsOn": ["web: install", "web: build", "build"],
      "problemMatcher": []
    },
    {
      "label": "publish",
      "command": "dotnet",
      "type": "process",
      "args": [
        "publish",
        "${workspaceFolder}/StageZero/StageZero.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "watch",
      "command": "dotnet",
      "type": "process",
      "args": ["watch", "run", "--project", "${workspaceFolder}/StageZero/StageZero.csproj"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Kill StageZero",
      "type": "shell",
      "command": "pkill -f 'dotnet.*StageZero' || echo 'No StageZero process found'",
      "presentation": { "reveal": "always", "focus": false, "panel": "shared", "showReuseMessage": false },
      "problemMatcher": []
    },
    {
      "label": "container: release up",
      "type": "shell",
      "command": "docker compose up --build -d",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "container: release down",
      "type": "shell",
      "command": "docker compose down",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "container: release logs",
      "type": "shell",
      "command": "docker compose logs -f",
      "isBackground": true,
      "presentation": { "reveal": "always", "focus": true, "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "container: debug up",
      "type": "shell",
      "command": "docker compose -f docker-compose.debug.yml up --build -d",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "container: debug down",
      "type": "shell",
      "command": "docker compose -f docker-compose.debug.yml down",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "container: debug logs",
      "type": "shell",
      "command": "docker compose -f docker-compose.debug.yml logs -f",
      "isBackground": true,
      "presentation": { "reveal": "always", "focus": true, "panel": "dedicated" },
      "problemMatcher": []
    }
  ]
}
