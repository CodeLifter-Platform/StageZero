{
  "version": "0.2.0",
  "configurations": [
    {
      // The API under the debugger on https://localhost:5001. Paired with the Vite config
      // in the compound below, which is what opens the browser (on :5173).
      "name": "StageZero API (.NET)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/StageZero/bin/Debug/net10.0/StageZero.dll",
      "args": [],
      "cwd": "${workspaceFolder}/StageZero",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:5001;http://localhost:5000"
      },
      "envFile": "${workspaceFolder}/.env"
    },
    {
      // The web app with hot reload, proxying /api to the API above.
      "name": "StageZero web (Vite)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "preLaunchTask": "web: install",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "http://localhost:5173"
      }
    },
    {
      // The API alone, serving the web app it built: what the release container does,
      // but on the host, under the debugger. No hot reload for the UI.
      "name": "StageZero API only (serves built web app)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build + web",
      "program": "${workspaceFolder}/StageZero/bin/Debug/net10.0/StageZero.dll",
      "args": [],
      "cwd": "${workspaceFolder}/StageZero",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:5001;http://localhost:5000"
      },
      "envFile": "${workspaceFolder}/.env"
    },
    {
      // docker-compose.debug.yml in the terminal: API with dotnet watch on :5200, web app
      // with hot reload on :5173. Attach the debugger with the config below.
      "name": "StageZero container (debug)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "-f", "docker-compose.debug.yml", "up", "--build"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Local:\\s+http://localhost:5173",
        "uriFormat": "http://localhost:5173"
      },
      "postDebugTask": "container: debug down"
    },
    {
      // Breakpoints inside the debug container. Pick the process named StageZero; after
      // dotnet watch restarts the app, attach again.
      "name": "StageZero container: attach (debug)",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickRemoteProcess}",
      "pipeTransport": {
        "pipeCwd": "${workspaceFolder}",
        "pipeProgram": "docker",
        "pipeArgs": ["exec", "-i", "stagezero-debug"],
        "debuggerPath": "/vsdbg/vsdbg",
        "quoteArgs": false
      },
      "sourceFileMap": {
        "/src": "${workspaceFolder}"
      }
    },
    {
      // docker-compose.yml in the terminal: the release image on :5100.
      "name": "StageZero container (release)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "up", "--build"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on:\\s+(https?://\\S+)",
        "uriFormat": "http://localhost:5100"
      },
      "postDebugTask": "container: release down"
    },
    {
      "name": ".NET Core Attach",
      "type": "coreclr",
      "request": "attach"
    }
  ],
  "compounds": [
    {
      "name": "StageZero (API + web)",
      "configurations": ["StageZero API (.NET)", "StageZero web (Vite)"],
      "stopAll": true
    }
  ]
}
