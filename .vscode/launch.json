{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "StageZero API (.NET)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/StageZero/bin/Debug/net10.0/StageZero.dll",
      "args": [],
      "cwd": "${workspaceFolder}/StageZero",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "http://localhost:5173"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:5001;http://localhost:5000"
      },
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "StageZero web (Vite)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "console": "integratedTerminal",
      "preLaunchTask": "web: install"
    },
    {
      "name": "StageZero (Https)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/StageZero/bin/Debug/net10.0/StageZero.dll",
      "args": [],
      "cwd": "${workspaceFolder}/StageZero",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:5001;http://localhost:5000"
      },
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": ".NET Core Attach",
      "type": "coreclr",
      "request": "attach"
    },
    {
      "name": "Docker Compose",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickRemoteProcess}",
      "pipeTransport": {
        "pipeCwd": "${workspaceFolder}",
        "pipeProgram": "docker",
        "pipeArgs": [
          "exec",
          "-i",
          "stagezero"
        ],
        "debuggerPath": "/vsdbg/vsdbg",
        "quoteArgs": false
      },
      "sourceFileMap": {
        "/src": "${workspaceFolder}"
      },
      "preLaunchTask": "docker-compose-up",
      "postDebugTask": "docker-compose-logs"
    },
    {
      "name": "Docker Compose (Simple)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "docker-compose",
      "runtimeArgs": [
        "-f",
        "debug.docker-compose.yml",
        "up",
        "--build"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "Now listening on: (https?://[^\\s]+)",
        "uriFormat": "http://localhost:5000",
        "action": "openExternally"
      },
      "preLaunchTask": "docker-compose-down"
    },
    {
      "name": "StageZero (Docker Compose)",
      "type": "docker",
      "request": "launch",
      "preLaunchTask": "docker-run: debug",
      "netCore": {
        "appProject": "${workspaceFolder}/StageZero/StageZero.csproj"
      }
    },
    {
      "name": "StageZero (Docker)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "docker-compose",
      "runtimeArgs": [
        "-f",
        "debug.docker-compose.yml",
        "up",
        "--build"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "Now listening on: (https?://[^\\s]+)",
        "uriFormat": "http://localhost:5000",
        "action": "openExternally"
      },
      "preLaunchTask": "docker-compose-down"
    }
  ],
  "compounds": [
    {
      "name": "StageZero (API + web)",
      "configurations": [
        "StageZero API (.NET)",
        "StageZero web (Vite)"
      ],
      "stopAll": true
    }
  ]
}
